# All optional. Copy to .env.local.

# Claude: labels sentiment/emotion/intent and drafts profiles from plain English.
# Without it, the app uses offline heuristics.
ANTHROPIC_API_KEY=
# ENRICH_MODEL=claude-haiku-5-5
# ASSIST_MODEL=claude-opus-5-5

# Bluesky: the public search endpoint refuses anonymous calls; sign in with an app password
# (Settings → Privacy and security → App passwords).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
# Real-time stream (on by default on the hosted server; no key needed)
# BLUESKY_JETSTREAM=off
# BLUESKY_FLUSH_SECONDS=120

# Reddit Data API (app at reddit.com/prefs/apps; access is approved manually by Reddit).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:earshot:0.2 (by /u/yourname)
# REDDIT_SUBREDDITS=Cruise,CruiseLife    # also read every new comment in these
# REDDIT_MAX_TERMS=15

# X API v2 (console.x.com). Pay-per-use: reads stop for the day at X_DAILY_POST_BUDGET posts.
X_BEARER_TOKEN=
# X_DAILY_POST_BUDGET=300

# Threads keyword search (Meta app with threads_keyword_search).
THREADS_ACCESS_TOKEN=

# Instagram hashtag search (Business/Creator account + Meta App Review).
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_MAX_HASHTAGS=10
# META_GRAPH_VERSION=v22.0

# YouTube Data API v3 key (search costs 100 quota units per term).
YOUTUBE_API_KEY=
# YOUTUBE_MAX_TERMS=10

# News & RSS: extra feeds to always read, comma-separated. Google News search is on unless NEWS_SEARCH_RSS=0.
RSS_FEEDS=
# NEWS_SEARCH_RSS=1
# NEWS_MAX_PER_FEED=20      # newest items kept per news search

# Mastodon instances to read hashtag timelines from.
# MASTODON_INSTANCES=mastodon.social

# Digest email via Resend.
RESEND_API_KEY=
DIGEST_TO=
# DIGEST_FROM=Earshot <digest@yourdomain.com>

# Storage: Postgres when DATABASE_URL is set (Railway: ${{Postgres.DATABASE_URL}}), otherwise a
# JSON file. On first start against an empty database the JSON file is imported.
# DATABASE_URL=
# EARSHOT_DATA_FILE=.data/earshot.json
# Only for tests: a scratch database the Postgres store test may wipe.
# TEST_DATABASE_URL=

# Hosting
# APP_PASSWORD=            # setup code for creating the first account at /setup (unset = no code, local dev only)
# AUTH_SECRET=             # signs sessions (required in production); changing it signs everyone out
# CRON_SECRET=             # enables POST /api/cron with "Authorization: Bearer <secret>"
# INGEST_INTERVAL_MINUTES=60
# SCHEDULER=off            # disable the built-in schedule

# Alert channels (used when a profile turns the channel on)
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=
