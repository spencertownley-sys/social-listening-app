# All optional. Copy to .env.local.

# Claude: labels sentiment/emotion/intent and drafts profiles from plain English.
# Without it, the app uses offline heuristics.
ANTHROPIC_API_KEY=
# ENRICH_MODEL=claude-haiku-5-5
# ASSIST_MODEL=claude-opus-5-5

# Bluesky: the public search endpoint refuses anonymous calls; sign in with an app password
# (Settings → Privacy and security → App passwords).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social

# YouTube Data API v3 key (search costs 100 quota units per term).
YOUTUBE_API_KEY=
# YOUTUBE_MAX_TERMS=10

# News & RSS: extra feeds to always read, comma-separated. Google News search is on unless NEWS_SEARCH_RSS=0.
RSS_FEEDS=
# NEWS_SEARCH_RSS=1

# Mastodon instances to read hashtag timelines from.
# MASTODON_INSTANCES=mastodon.social

# Digest email via Resend.
RESEND_API_KEY=
DIGEST_TO=
# DIGEST_FROM=Earshot <digest@yourdomain.com>

# Where the local JSON store lives.
# EARSHOT_DATA_FILE=.data/earshot.json
